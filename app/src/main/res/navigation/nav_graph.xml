<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.skedu.app.ui.auth.LoginFragment"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_groups"
            app:destination="@id/groupsFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.skedu.app.ui.auth.RegisterFragment"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_groups"
            app:destination="@id/groupsFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/groupsFragment"
        android:name="com.skedu.app.ui.groups.GroupsFragment"
        tools:layout="@layout/fragment_groups">
        <action
            android:id="@+id/action_groups_to_detail"
            app:destination="@id/groupDetailFragment" />
        <action
            android:id="@+id/action_groups_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/groupDetailFragment"
        android:name="com.skedu.app.ui.groups.GroupDetailFragment"
        tools:layout="@layout/fragment_group_detail">
        <action
            android:id="@+id/action_detail_to_task_form"
            app:destination="@id/taskFormFragment" />
    </fragment>

    <!-- Lote 2: tarefas de todos os grupos do usuário (aba da navegação inferior) -->
    <fragment
        android:id="@+id/myTasksFragment"
        android:name="com.skedu.app.ui.tasks.MyTasksFragment"
        tools:layout="@layout/fragment_my_tasks">
        <action
            android:id="@+id/action_mytasks_to_task_form"
            app:destination="@id/taskFormFragment" />
    </fragment>

    <!-- Criar/editar tarefa (argumentos: groupId e, ao editar, taskId) -->
    <fragment
        android:id="@+id/taskFormFragment"
        android:name="com.skedu.app.ui.tasks.TaskFormFragment"
        tools:layout="@layout/fragment_task_form" />
</navigation>

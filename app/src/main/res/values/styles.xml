<?xml version="1.0" encoding="utf-8"?>
<!--
  Estilos compartilhados do Skedu. O tema (themes.xml) aponta materialButtonStyle e
  textInputStyle para cá, então toda tela herda botões e campos no padrão sem repetir style=.
  Alvo de toque mínimo: 48dp. Escala de espaçamento: 4/8/12/16/24/32dp.
-->
<resources>

    <!-- Campos de texto: contorno com cantos suaves -->
    <style name="Widget.Skedu.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- Texto de botões em negrito -->
    <style name="TextAppearance.Skedu.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Botão principal (preenchido) -->
    <style name="Widget.Skedu.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Skedu.Button</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Botão de destaque (laranja): a ação principal da tela, no máximo um por tela -->
    <style name="Widget.Skedu.Button.Accent" parent="Widget.Skedu.Button">
        <item name="backgroundTint">?attr/colorTertiary</item>
        <item name="android:textColor">?attr/colorOnTertiary</item>
    </style>

    <!-- Botão secundário tonal -->
    <style name="Widget.Skedu.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Skedu.Button</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Cartão com contorno suave, sem sombra -->
    <style name="Widget.Skedu.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Botão secundário (contorno) -->
    <style name="Widget.Skedu.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Skedu.Button</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
    </style>

    <!-- Botão de texto (links como "Esqueci minha senha") -->
    <style name="Widget.Skedu.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Skedu.Button</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Título de tela -->
    <style name="TextAppearance.Skedu.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Texto de apoio abaixo de títulos -->
    <style name="TextAppearance.Skedu.Subtitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
